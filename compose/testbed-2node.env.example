# Copy to compose/.env on each testbed host and edit per host.
DAOS_IMAGE_NSP=daos
DAOS_IMAGE_TAG=2.8.0-dev
DAOS_SYSTEM_NAME=daos_server
# Phase 0: two hosts only -> a single MS replica (not HA). See ADR-001.
DAOS_MS_REPLICAS=cell1              # server key is mgmt_svc_replicas (2.6+); agent still uses access_points
DAOS_PROVIDER=ofi+verbs;ofi_rxm
DAOS_FABRIC_IFACE=ens2          # cell2 is ens2np0 -- never copy this file between hosts
DAOS_BDEV_LIST=0000:03:00.0     # check PCI DSN first: dual-port chassis exposes the same drive to both hosts
DAOS_SCM_SIZE_GB=32
DAOS_NR_HUGEPAGES=8192
DAOS_ALLOW_INSECURE=true        # Phase 0 only. For TLS: scripts/gen-certs.sh, mount the per-role dir
                                # at /etc/daos/certs (see compose/README.md) and set this to false.
DAOS_CERTS_DIR=                 # host dir holding server/ agent/ admin/ from scripts/gen-certs.sh
