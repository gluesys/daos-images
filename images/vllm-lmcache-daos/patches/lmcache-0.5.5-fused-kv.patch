LMCache 0.5.5 VLLMPagedMemGPUConnectorV2 + vLLM 0.30 fused K/V layout
([NB, BS, NH, 2*HD] per layer): the memory object is [2, NL, T, NH*HD], and
the native kernel fills plane 0 with NH*2*HD values per token, so it moves
only the first half of each chunk's tokens. Hits then reuse stale KV for the
other half (needle test: 55 % -> 97.5 % after this patch). The patch views
the object as [1, NL, T, 2*NH*HD] for the fused formats at the 3 kernel calls.
Applied in site-packages with `patch -p1`.

--- a/lmcache/v1/gpu_connector/gpu_connectors.py
+++ b/lmcache/v1/gpu_connector/gpu_connectors.py
@@ -243,6 +243,17 @@
             layout_hints=layout_hints,
         )
 
+    def _kernel_view(self, t: torch.Tensor) -> torch.Tensor:
+        # Gluesys patch: vLLM 0.30 fused K/V layouts are one plane of NH * 2 * HD
+        # per token, but the memory object is [2, NL, T, NH * HD]; without this
+        # view the kernel moves only the first half of the bytes.
+        if self.engine_kv_format in (
+            lmcache_native.EngineKVFormat.NL_X_NB_BS_NH_CS,
+            lmcache_native.EngineKVFormat.NL_X_NB_NH_BS_CS,
+        ) and t.shape[0] == 2:
+            return t.view(1, t.shape[1], t.shape[2], 2 * t.shape[3])
+        return t
+
     def _initialize_pointers(self, kv_caches: List[torch.Tensor]) -> torch.Tensor:
         self.device = kv_caches[0].device
         assert self.device.type == "cuda", "The device should be CUDA."
@@ -325,7 +336,7 @@
         skip_prefix_n_tokens = min(end - start, max(0, vllm_cached - start))
 
         device_ops.multi_layer_kv_transfer(
-            memory_obj.tensor,
+            self._kernel_view(memory_obj.tensor),
             kv_cache_pointers,
             slot_mapping[start:end],
             self.device,
@@ -374,7 +385,7 @@
         with torch.cuda.stream(self.store_stream):
             if self.gpu_buffer is None or end - start != self.gpu_buffer.shape[2]:
                 device_ops.multi_layer_kv_transfer(
-                    memory_obj.tensor,
+                    self._kernel_view(memory_obj.tensor),
                     kv_cache_pointers,
                     slot_mapping[start:end],
                     self.kvcaches[0].device,
@@ -390,7 +401,7 @@
                 assert self.gpu_buffer.device == self.kvcaches[0].device
                 tmp_gpu_buffer = self.gpu_buffer[:, :, : end - start, :]
                 device_ops.multi_layer_kv_transfer(
-                    tmp_gpu_buffer,
+                    self._kernel_view(tmp_gpu_buffer),
                     kv_cache_pointers,
                     slot_mapping[start:end],
                     self.kvcaches[0].device,
